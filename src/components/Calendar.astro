<style>
  details {
    background-color: color-mix(in srgb, var(--background-color), black 5%);
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    min-width: 0;
  }

  summary {
    background-color: var(--background-color);
    color: var(--foreground-color);
    padding: 1rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  summary::-webkit-details-marker,
  summary::marker {
    display: none;
  }

  summary:after {
    content: " ▼";
  }

  details[open] summary:after {
    content: " ▲";
  }

  #scrollbox {
    overflow: auto;
  }

  table {
    border-collapse: collapse;
  }

  table :global(tr:nth-child(even)) {
    background-color: var(--background-color);
  }

  table :global(tr:nth-child(odd)) {
    background-color: color-mix(in srgb, var(--background-color), black 5%);
  }

  table :global(th, td) {
    padding: 0.5rem 1rem;
    text-align: center;
    background-color: inherit;
    white-space: nowrap;
  }

  /* Hour Cells */
  table :global(tr td:first-child) {
    color: color-mix(in srgb, var(--foreground-color), black 20%);
    padding: 0.5rem;
  }

  /* Event Cells */
  table :global(tr td:not(:first-child):not(:empty):not(.ideal):not(.not-ideal)) {
    background-color: var(--accent-color);
    color: var(--onaccent-color);
  }

  /* Ideal Cells */
  table :global(tr td.ideal) {
    background-color: var(--accent-color);
    color: var(--onaccent-color);
  }

  /* Non-ideal Cells */
  table :global(tr td.not-ideal) {
    background-color: color-mix(in srgb, var(--background-color), black 10%) !important;
    color: color-mix(in srgb, var(--foreground-color), transparent 70%) !important;
  }

  table :global(tr > :first-child) {
    position: sticky;
    left: 0;
  }

  .timezone-note {
    font-size: 0.85em;
    margin-block: 0.5rem;
    padding-inline: 1rem;
    color: color-mix(in srgb, var(--foreground-color), transparent 30%);
    text-align: right;
  }
</style>

<details id="details">
  <summary id="summary"></summary>
  <div id="scrollbox">
    <table>
      <thead id="thead"></thead>
      <tbody id="tbody"></tbody>
    </table>
    <div class="timezone-note" id="timezone-note"></div>
  </div>
</details>

<script src="@scripts/calendar.ts"></script>
