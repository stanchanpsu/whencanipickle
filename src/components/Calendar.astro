<style>
  details {
    background-color: color-mix(in srgb, var(--background-color), black 5%);
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    grid-area: calendar;
    min-width: 0;
  }

  summary {
    background-color: var(--background-color);
    color: var(--foreground-color);
    padding: 1rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  summary::-webkit-details-marker,
  summary::marker {
    display: none;
  }

  summary:after {
    content: " ▼";
  }

  details[open] summary:after {
    content: " ▲";
  }

  #scrollbox {
    overflow: auto;
  }

  table {
    border-collapse: collapse;
    width: 800px;
  }

  table :global(tr:nth-child(even)) {
    background-color: var(--background-color);
  }

  table :global(tr:nth-child(odd)) {
    background-color: color-mix(in srgb, var(--background-color), black 5%);
  }

  table :global(th, td) {
    padding: 0.5rem;
    text-align: center;
    background-color: inherit;
  }

  /* Hour Cells */
  table :global(tr td:first-child) {
    color: color-mix(in srgb, var(--foreground-color), black 20%);
  }

  /* Event Cells */
  table :global(tr td:not(:first-child):not(:empty)) {
    background-color: var(--accent-color);
    color: var(--onaccent-color);
  }

  table :global(tr > :first-child) {
    position: sticky;
    left: 0;
  }
</style>

<details id="details">
  <summary id="summary"></summary>
  <div id="scrollbox">
    <table>
      <thead id="thead"></thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>
</details>

<script src="@scripts/calendar.ts"></script>
