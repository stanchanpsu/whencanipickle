---
import ModeSwitch from '@components/ModeSwitch.astro';
---

<style>
    header {
        align-self: stretch;
        display: flex;
        justify-content: end;
    }

    .content {
        grid-row: 1 / -1;
        grid-column: 1 / -1;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
        isolation: isolate;
        padding: 2rem;
    }

    .card {
        background-color: color-mix(
            in srgb,
            var(--background-color),
            transparent 10%
        );
        border-radius: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border: 1px solid color-mix(in srgb, var(--background-color), white 10%);
        backdrop-filter: blur(4px);
        padding: 2rem;
        max-width: 90vw;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
    }

    </style>

<div class="content">
    <header>
        <ModeSwitch/>
    </header>
    <div class="card">
        <slot />
    </div>
</div>
